{
  "name": "dsh-rice-patrol",
  "version": "0.2.4",
  "private": true,
  "license": "MIT",
  "description": "Rice Patrol: bounded reasoning repetition guard and clean recovery for DeepSeek Harness",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": "./client/entry.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "settings.mjs",
    "status-store.mjs",
    "tool-journal.mjs",
    "core/*.mjs",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "config/*.yml",
    "client/entry.mjs",
    "web-rpc.mjs"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs client/entry.test.mjs",
    "check": "node --check index.mjs && node --check client/entry.mjs",
    "pack:local": "npm pack --ignore-scripts"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.1.6-alpha.2",
    "@deepseek-ai/schemastery": "^3.18.2"
  }
}
